# Personio company career subdomain (https://{subdomain}.jobs.personio.de)
PERSONIO_COMPANY_SUBDOMAIN=attolabs

# Exposed to the browser build (jobs XML feed). Defaults to attolabs if unset.
VITE_PERSONIO_SUBDOMAIN=attolabs

# From Personio: Settings → Security & integrations → API credentials → Recruiting integrations
PERSONIO_COMPANY_ID=
PERSONIO_ACCESS_TOKEN=

# Optional: recruiting channel id so applications show source "Website"
PERSONIO_RECRUITING_CHANNEL_ID=

# API server port (Vite proxies /api here in development)
API_PORT=8787
